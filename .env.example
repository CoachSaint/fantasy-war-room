NEXT_PUBLIC_APP_NAME="Fantasy War Room"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Browser-safe Supabase project values. Leave blank to stay in demo mode.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never expose these in client bundles, logs, or screenshots.
SUPABASE_SERVICE_ROLE_KEY=""
CRON_SECRET=""
# Server-only OpenRouter credential for non-demo Coach responses.
OPENROUTER_API_KEY=""
# Optional official nflverse release mirror/base. Do not point this at the old master tree.
NFLVERSE_RELEASE_BASE_URL="https://github.com/nflverse/nflverse-data/releases/download"
SCOUT_USER_AGENT="FantasyWarRoom/0.1 contact@example.com"
# Keep true until Supabase, league membership, and current provider data are verified.
NEXT_PUBLIC_DEMO_MODE="true"
